# ===== CodingApp configuration =====
# Edit, then apply with:  ./codingapp.sh restart
# Write values WITHOUT quotes.

# Runtime image to run: codingapp-runtime:<RUNTIME_VERSION> (set automatically by install/update).
# The application version comes from code/VERSION.
RUNTIME_VERSION=1
# Host port and bind address of the web UI
APP_PORT=8090
APP_BIND=0.0.0.0

# ---- Built-in administrator (always works, even if LDAP is misconfigured) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs login sessions and encrypts the stored LDAP bind password.
# install.sh generates a random value. Do NOT change it later, or the saved
# LDAP password can no longer be decrypted and every user is signed out.
SECRET_KEY=

# ---- LLM: OpenAI-compatible server (vLLM) ----
# vLLM on this Docker host (port published):  http://host.docker.internal:8000/v1
# vLLM on another server:                     http://10.0.0.5:8000/v1
LLM_BASE_URL=http://host.docker.internal:8000/v1
# Same value as vLLM --api-key (anything if vLLM has no key)
LLM_API_KEY=EMPTY
# Empty = first model served by vLLM
LLM_MODEL=
# 0 = auto-detect from vLLM (max_model_len). Set a number to override.
LLM_CONTEXT_TOKENS=0
# Max tokens generated per request; reserved out of the context window.
# Rule of thumb: <= 1/4 of the context (32K context -> 8192, 256K context -> 32768)
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
# Initial thinking mode (empty/true/false). Admins can change it in Administration -> LLM.
LLM_ENABLE_THINKING=
# Automatic continuations when an answer hits the output limit
LLM_AUTO_CONTINUE=3
# Seconds to wait for a single LLM answer
LLM_REQUEST_TIMEOUT=1800

# ---- Upload limits ----
MAX_UPLOAD_MB=25
MAX_EXTRACTED_MB=200
MAX_FILES=5000
MAX_FILE_KB=2048

# ---- Sessions ----
SESSION_HOURS=12
# true when users reach the app over HTTPS (reverse proxy)
COOKIE_SECURE=false
